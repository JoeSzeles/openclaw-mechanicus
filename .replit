modules = ["swift-5.8", "bash", "nodejs-22", "python-3.11", "postgresql-16"]
[agent]
expertMode = true
integrations = ["github:1.0.0"]

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
OPENCLAW_GATEWAY_PORT = "5001"
OPENCLAW_SKIP_CHANNELS = "1"
IG_API_KEY = "YOUR_IG_API_KEY"
IG_USERNAME = "YOUR_IG_USERNAME"
IG_PASSWORD = "YOUR_IG_PASSWORD"
IG_ACCOUNT_ID = "Z3MJKY"
IG_BASE_URL = "https://demo-api.ig.com/gateway/deal"
OPENCLAW_GATEWAY_TOKEN = "YOUR_GATEWAY_TOKEN"
OPENCLAW_LOGIN_USER = "Josef_Szeles"
CANVAS_API_KEY = "YOUR_CANVAS_API_KEY"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "COREPACK_ENABLE_STRICT=0 bash start.sh"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 5012
externalPort = 3002

[deployment]
deploymentTarget = "vm"
run = ["bash", "start.sh"]
build = ["npm", "install", "--omit=dev", "--legacy-peer-deps", "--no-audit", "--no-fund"]
publicDir = "dist"
