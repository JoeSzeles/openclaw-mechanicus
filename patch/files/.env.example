# IG Trading API Credentials
IG_API_KEY=your_ig_api_key
IG_USERNAME=your_ig_username
IG_PASSWORD=your_ig_password
IG_ACCOUNT_ID=your_account_id
IG_ACCOUNT_TYPE=demo

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/openclaw

# AI (optional - for AI calibration features)
GROQ_API_KEY=your_groq_api_key

# OpenClaw Login (optional - protects the web UI)
OPENCLAW_LOGIN_USER=
OPENCLAW_LOGIN_PASSWORD=

# OpenClaw Gateway Token (auto-generated if empty)
OPENCLAW_GATEWAY_TOKEN=
