{
  "file": "brain-dashboard.html",
  "content": "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Neural Trading Brain Dashboard</title><link href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css\" rel=\"stylesheet\" integrity=\"sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH\" crossorigin=\"anonymous\"><script src=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js\" integrity=\"sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz\" crossorigin=\"anonymous\"></script><script src=\"https://cdn.jsdelivr.net/npm/chart.js\"></script><style>body{padding:20px;background:#f8f9fa;}#statusSection,#patternsSection,#cortexSection,#archSection,#stimulateSection{margin-bottom:2rem;}canvas{max-height:400px;}@media (max-width:768px){canvas{max-height:300px;}}</style></head><body><div class=\"container-fluid\"><h1 class=\"mb-4\">🧠 Neural Trading Brain Dashboard</h1><div id=\"statusSection\"><h2>Status</h2><div id=\"status\" class=\"alert alert-info\">Loading...</div></div><div id=\"bootSection\" class=\"card mb-4\" style=\"display:none;\"><div class=\"card-body\"><h3>Boot Brain</h3><form id=\"bootForm\"><div class=\"row\"><div class=\"col-md-4\"><label>Sensory Neurons</label><input id=\"sensory\" class=\"form-control\" value=\"128\" type=\"number\"></div><div class=\"col-md-4\"><label>Inter Neurons</label><input id=\"inter\" class=\"form-control\" value=\"256\" type=\"number\"></div><div class=\"col-md-4\"><label>Motor Neurons</label><input id=\"motor\" class=\"form-control\" value=\"16\" type=\"number\"></div></div><button type=\"button\" class=\"btn btn-primary mt-3\" onclick=\"bootBrain()\">Boot Brain</button></form></div></div><div id=\"archSection\"><h2>Architecture</h2><canvas id=\"archChart\"></canvas><div id=\"archText\"></div></div><div id=\"patternsSection\"><h2>Patterns</h2><table class=\"table table-striped\" id=\"patternsTable\"><thead><tr><th>Epic</th><th>Direction</th><th>Count</th><th>Strength</th></tr></thead><tbody></tbody></table><a id=\"csvLink\" class=\"btn btn-outline-secondary\" style=\"display:none;\">Export CSV</a></div><div id=\"cortexSection\"><h2>Cortex Trades</h2><canvas id=\"equityChart\"></canvas><table class=\"table table-striped mt-3\" id=\"tradeTable\"><thead><tr><th>Time</th><th>Epic</th><th>Action</th><th>PnL</th></tr></thead><tbody></tbody></table><button class=\"btn btn-warning\" onclick=\"clearCortex()\">Clear Cortex State</button></div><div id=\"stimulateSection\"><h2>Stimulate Price</h2><form id=\"stimForm\"><div class=\"row\"><div class=\"col-md-3\"><input id=\"epic\" class=\"form-control\" placeholder=\"CS.D.CFASILVER.CFA.IP\" value=\"CS.D.CFASILVER.CFA.IP\"></div><div class=\"col-md-2\"><input id=\"price\" class=\"form-control\" type=\"number\" placeholder=\"8500\" step=\"0.01\"></div><div class=\"col-md-2\"><input id=\"prevPrice\" class=\"form-control\" type=\"number\" placeholder=\"8490\" step=\"0.01\"></div><div class=\"col-md-2\"><input id=\"volume\" class=\"form-control\" type=\"number\" placeholder=\"100\"></div><div class=\"col-md-3\"><button type=\"button\" class=\"btn btn-success w-100\" onclick=\"stimulate()\">Stimulate</button></div></div></form><div id=\"signals\" class=\"alert alert-secondary mt-2\"></div></div><div class=\"row\"><div class=\"col-md-6\"><h3>Feedback</h3><button class=\"btn btn-success me-2\" onclick=\"feedback('sugar','motor')\">🍭 Sugar Motor</button><button class=\"btn btn-success me-2\" onclick=\"feedback('sugar','mushroom')\">🍭 Sugar Mushroom</button><button class=\"btn btn-danger me-2\" onclick=\"feedback('pain','motor')\">💥 Pain Motor</button><button class=\"btn btn-danger\" onclick=\"feedback('pain','mushroom')\">💥 Pain Mushroom</button></div><div class=\"col-md-6\"><h3>Controls</h3><button class=\"btn btn-primary me-2\" onclick=\"saveState()\">💾 Save State</button><button class=\"btn btn-info\" onclick=\"refreshAll()\">🔄 Refresh All</button></div></div></div><script>const API_BASE='/api/brain/';let apiKey=localStorage.getItem('brainApiKey')||'';let charts={};async function apiFetch(path,opts={}){let headers={'Content-Type':'application/json',...opts.headers||{}};if(apiKey)headers['x-brain-api-key']=apiKey;let res=await fetch(API_BASE+path,{...opts,headers,credentials:'include'});if(res.status===403&&!apiKey){const key=prompt('Enter BRAIN_API_KEY for brain access:');if(key){localStorage.setItem('brainApiKey',key);apiKey=key;return apiFetch(path,opts);}throw new Error('Authentication required.');}if(!res.ok){const err=await res.text();throw new Error(err);}return res.status!==204?await res.json():{};}async function loadStatus(){try{const status=await apiFetch('status');const statusDiv=document.getElementById('status');statusDiv.className='alert alert-'+(status.loaded?'success':'warning');statusDiv.innerHTML=`<strong>Loaded:</strong> ${status.loaded?'✅ Yes':'❌ No'} | <strong>Sensory:</strong> ${status.sensoryNeurons||0} | <strong>Inter:</strong> ${status.interNeurons||0} | <strong>Motor:</strong> ${status.motorNeurons||0} | <strong>Steps:</strong> ${status.step_count||0} | <strong>Patterns:</strong> ${status.patterns||0}<br>${status.trainingMode?'Training: '+status.trainingMode:'Idle'}`;document.getElementById('bootSection').style.display=status.loaded?'none':'block';if(status.loaded){loadArch();loadPatterns();loadCortex();}else{statusDiv.innerHTML+='<br><em>Boot the brain to enable full dashboard.</em>';}}catch(e){document.getElementById('status').innerHTML=`<div class=\"alert alert-danger\">Error: ${e.message}</div>`;}}async function bootBrain(){try{const sensory=parseInt(document.getElementById('sensory').value)||128;const inter=parseInt(document.getElementById('inter').value)||256;const motor=parseInt(document.getElementById('motor').value)||16;await apiFetch('boot',{method:'POST',body:JSON.stringify({sensory,inter,motor})});alert('Brain booted! Refreshing...');loadStatus();}catch(e){alert('Boot failed: '+e.message);}}async function loadArch(){try{const arch=await apiFetch('architecture');const regions=arch.regions||[];document.getElementById('archText').innerHTML=`Regions: ${regions.length} | Total Neurons: ${regions.reduce((s,r)=>s+r.count,0)}`;const ctx=document.getElementById('archChart').getContext('2d');if(charts.arch)charts.arch.destroy();charts.arch=new Chart(ctx,{type:'doughnut',data:{labels:regions.map(r=>r.name),datasets:[{data:regions.map(r=>r.count),backgroundColor:['#ff6384','#36a2eb','#ffce56','#4bc0c0','#9966ff']}]},options:{responsive:true,plugins:{legend:{position:'bottom'}}}});}catch(e){console.warn('Arch load:',e);}}async function loadPatterns(){try{const data=await apiFetch('patterns');const pats=data.patterns||[];let html='';pats.slice(0,50).forEach(p=>{html+=`<tr><td>${p.epic||'N/A'}</td><td>${p.direction||'N/A'}</td><td>${p.count||0}</td><td>${p.strength?.toFixed(2)||'N/A'}</td></tr>`;});document.querySelector('#patternsTable tbody').innerHTML=html;if(pats.length>0){const csv='Epic,Direction,Count,Strength\\n'+pats.map(p=>`${p.epic},${p.direction},${p.count},${p.strength}`).join('\\n');const blob=new Blob([csv],{type:'text/csv'});const url=URL.createObjectURL(blob);document.getElementById('csvLink').href=url;document.getElementById('csvLink').download='brain-patterns.csv';document.getElementById('csvLink').style.display='inline-block';}else{document.querySelector('#patternsTable tbody').innerHTML='<tr><td colspan=4>No patterns yet.</td></tr>';}}catch(e){console.warn('Patterns load:',e);}}async function loadCortex(){try{const state=await apiFetch('cortex-state');const trades=state.tradeLog||[];const recentTrades=trades.slice(-20);let html='';recentTrades.forEach(t=>{html+=`<tr><td>${new Date(t.timestamp||0).toLocaleString()}</td><td>${t.epic||'N/A'}</td><td>${t.action||'hold'}</td><td>${t.pnl?.toFixed(2)||0}</td></tr>`;});document.querySelector('#tradeTable tbody').innerHTML=html;const labels=trades.slice(-100).map(t=>new Date(t.timestamp||0).toLocaleTime()).slice(-100);const data=trades.slice(-100).reduce((acc,t,i)=>{acc.push((acc[i-1]||0)+(t.pnl||0));return acc;},[0]).slice(-100);const ctx=document.getElementById('equityChart').getContext('2d');if(charts.equity)charts.equity.destroy();charts.equity=new Chart(ctx,{type:'line',data:{labels,data,datasets:[{label:'Cumulative PnL',data:borderColor:'rgb(75,192,192)',tension:0.1}]},options:{responsive:true,scales:{y:{beginAtZero:false}}}});if(state.openPosition){document.querySelector('#tradeTable').insertAdjacentHTML('beforeend','<tfoot><tr class=\"table-info\"><td colspan=4>Open: '+JSON.stringify(state.openPosition)+'</td></tr></tfoot>');}}catch(e){console.warn('Cortex load:',e);}}async function stimulate(){try{const body={epic:document.getElementById('epic').value,price:parseFloat(document.getElementById('price').value),prevPrice:parseFloat(document.getElementById('prevPrice').value),volume:parseInt(document.getElementById('volume').value)||0};const res=await apiFetch('stimulate-price',{method:'POST',body:JSON.stringify(body)});document.getElementById('signals').innerHTML=`<div class=\"alert alert-success\"><strong>Buy Signal:</strong> ${(res.buy_signal||0).toFixed(3)} | <strong>Sell:</strong> ${(res.sell_signal||0).toFixed(3)} | <strong>Hold:</strong> ${(res.hold_signal||0).toFixed(3)}</div>`;}catch(e){document.getElementById('signals').innerHTML=`<div class=\"alert alert-danger\">${e.message}</div>`;}}async function feedback(type,target){try{await apiFetch('feedback',{method:'POST',body:JSON.stringify({type,target})});alert(`${type} to ${target} sent!`);}catch(e){alert('Feedback failed: '+e.message);}}async function clearCortex(){if(confirm('Clear all cortex trade history?')){await apiFetch('cortex-state',{method:'DELETE'});loadCortex();}}async function saveState(){try{await apiFetch('save',{method:'POST'});alert('State saved!');}catch(e){alert('Save failed: '+e.message);}}async function refreshAll(){loadStatus();loadPatterns();loadCortex();}window.onload=()=>{loadStatus();setInterval(refreshAll,30000); // auto-refresh 30s};</script></body></html>",
  "manifest": {
    "name": "Neural Brain Dashboard",
    "description": "Live control center for spiking neural trading brain: status, boot, patterns, cortex trades/equity chart, price stimulation, feedback, save. Responsive, auth-safe.",
    "category": "Neural"
  }
}